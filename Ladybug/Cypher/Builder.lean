import Ladybug.Cypher.Expr

/-!
# Query builder

Queries are built in `QueryM`, a state monad that appends clauses and hands out
fresh variable names (`n0`, `r1`, `v2`, … in clause order).

```lean
def employees : Query (String × String) := query do
  let p ← match_ (node Person)
  let (_, c) ← match_ (out p WorksAt (node Company))
  where_ (p.age >. 30)
  return_ (p.name, c.name)
```

Variables of declared tables are companion structures generated by
`node_table`/`rel_table` (`Person.Var`), whose fields are typed expressions.
-/

namespace Ladybug

open Cypher

variable {α β γ τ ρ σ : Type} {S T V O P Q RV RO : Type}

structure BuilderState where
  clauses : Array Core.Clause := #[]
  next : Nat := 0
  /-- ORDER BY / SKIP / LIMIT waiting for the next WITH or RETURN. -/
  pending : Core.Modifiers := {}
  deriving Inhabited

abbrev QueryM := StateM BuilderState

namespace QueryM

def fresh (pfx : String) : QueryM String :=
  modifyGet fun s => (s!"{pfx}{s.next}", { s with next := s.next + 1 })

def emit (c : Core.Clause) : QueryM Unit :=
  modify fun s => { s with clauses := s.clauses.push c }

def takePending : QueryM Core.Modifiers :=
  modifyGet fun s => (s.pending, { s with pending := {} })

end QueryM

/-! ## Variables -/

/-- Companion variables of a table: `mkVar` for MATCH, `mkOpt` (every property
nullable) for OPTIONAL MATCH. Generated by `node_table`/`rel_table`. -/
class HasVar (α : Type) (V O : outParam Type) where
  mkVar : String → V
  mkOpt : String → O

/-- `V` is a variable bound to a node of table `α`. -/
class NodeVarOf (V : Type) (α : outParam Type) where
  varName : V → String

/-- `O` is an OPTIONAL MATCH variable for a node of table `α`. -/
class OptNodeVarOf (O : Type) (α : outParam Type) where
  varName : O → String

/-- `V` is a variable bound to a relationship of table `ρ`. -/
class RelVarOf (V : Type) (ρ : outParam Type) where
  varName : V → String

class OptRelVarOf (O : Type) (ρ : outParam Type) where
  varName : O → String

/-- Any table variable, for DELETE and WITH. -/
class IsVar (V : Type) where
  varName : V → String

instance (priority := low) [NodeVarOf V α] : IsVar V := ⟨NodeVarOf.varName⟩
instance (priority := low) [RelVarOf V ρ] : IsVar V := ⟨RelVarOf.varName⟩
instance (priority := low) [OptNodeVarOf V α] : IsVar V := ⟨OptNodeVarOf.varName⟩
instance (priority := low) [OptRelVarOf V ρ] : IsVar V := ⟨OptRelVarOf.varName⟩

/-- A table variable as an expression, e.g. for `count(p)`. -/
def ref [IsVar V] (v : V) : Expr V := ⟨.var (IsVar.varName v)⟩

/-! ## Patterns -/

/-- A node of table `α` to be bound by a pattern. -/
structure NodeRef (α : Type) where
  props : List (String × Core.Expr) := []

def node (α : Type) : NodeRef α := {}

/-- `out a ρ b`: `(a)-[:ρ]->(b)`. `b` is a `node T` or an existing variable. -/
structure PatOut (S : Type) (ρ : Type) (T : Type) where
  src : S
  dst : T

/-- `inc a ρ b`: `(a)<-[:ρ]-(b)`. -/
structure PatIn (S : Type) (ρ : Type) (T : Type) where
  src : S
  dst : T

/-- `both a ρ b`: `(a)-[:ρ]-(b)`. -/
structure PatBoth (S : Type) (ρ : Type) (T : Type) where
  src : S
  dst : T

def out (src : S) (ρ : Type) (dst : T) : PatOut S ρ T := ⟨src, dst⟩
def inc (src : S) (ρ : Type) (dst : T) : PatIn S ρ T := ⟨src, dst⟩
def both (src : S) (ρ : Type) (dst : T) : PatBoth S ρ T := ⟨src, dst⟩

/-- Bind the end of a pattern: a new node (fresh variable) or an existing one. -/
class PatEnd (T : Type) (α : outParam Type) (V O : outParam Type) where
  bind : T → QueryM (Core.NodePat × V × O)

instance [NodeTable α] [HasVar α V O] : PatEnd (NodeRef α) α V O where
  bind n := do
    let v ← QueryM.fresh "n"
    return (⟨v, some (NodeTable.label α), n.props⟩, HasVar.mkVar α v, HasVar.mkOpt α v)

instance (priority := low) [NodeVarOf T α] [NodeTable α] : PatEnd T α T T where
  bind t := return (⟨NodeVarOf.varName t, none, []⟩, t, t)

/-- A pattern and the variables it binds, for MATCH (`R`) and OPTIONAL MATCH (`R'`). -/
class Matchable (P : Type) (R R' : outParam Type) where
  build : P → QueryM (Core.Pattern × R × R')

instance [NodeTable α] [HasVar α V O] : Matchable (NodeRef α) V O where
  build n := do
    let (np, v, o) ← PatEnd.bind n
    return (⟨np, []⟩, v, o)


-- @tg: implements:: [[openspec:cypher-query#Query builder]]
instance [NodeVarOf S σ] [RelTable ρ σ τ] [HasVar ρ RV RO] [PatEnd T τ V O] :
    Matchable (PatOut S ρ T) (RV × V) (RO × O) where
  build p := do
    let r ← QueryM.fresh "r"
    let (np, v, o) ← PatEnd.bind p.dst
    let pat : Core.Pattern := ⟨⟨NodeVarOf.varName p.src, none, []⟩, [(⟨some r, RelTable.label ρ, .out, []⟩, np)]⟩
    return (pat, (HasVar.mkVar ρ r, v), (HasVar.mkOpt ρ r, o))

instance [NodeVarOf S τ] [RelTable ρ σ τ] [HasVar ρ RV RO] [PatEnd T σ V O] :
    Matchable (PatIn S ρ T) (RV × V) (RO × O) where
  build p := do
    let r ← QueryM.fresh "r"
    let (np, v, o) ← PatEnd.bind p.dst
    let pat : Core.Pattern := ⟨⟨NodeVarOf.varName p.src, none, []⟩, [(⟨some r, RelTable.label ρ, .inc, []⟩, np)]⟩
    return (pat, (HasVar.mkVar ρ r, v), (HasVar.mkOpt ρ r, o))

instance [NodeVarOf S σ] [RelTable ρ σ τ] [HasVar ρ RV RO] [PatEnd T τ V O] :
    Matchable (PatBoth S ρ T) (RV × V) (RO × O) where
  build p := do
    let r ← QueryM.fresh "r"
    let (np, v, o) ← PatEnd.bind p.dst
    let pat : Core.Pattern := ⟨⟨NodeVarOf.varName p.src, none, []⟩, [(⟨some r, RelTable.label ρ, .both, []⟩, np)]⟩
    return (pat, (HasVar.mkVar ρ r, v), (HasVar.mkOpt ρ r, o))

/-! ## Clauses -/

/-- `MATCH pattern`; returns the variables the pattern binds. -/
def match_ {P R R' : Type} [Matchable P R R'] (p : P) : QueryM R := do
  let (pat, r, _) ← Matchable.build p
  QueryM.emit (.match false [pat])
  return r

/-- `OPTIONAL MATCH pattern`; every property of the bound variables is nullable. -/
def optMatch {P R R' : Type} [Matchable P R R'] (p : P) : QueryM R' := do
  let (pat, _, r') ← Matchable.build p
  QueryM.emit (.match true [pat])
  return r'

/-- `WHERE cond`: keeps the rows where `cond` is true (not false, not unknown). -/
def where_ [Expr.IsPred α] (cond : Expr α) : QueryM Unit := QueryM.emit (.where cond.raw)

/-- Sort the rows of the next WITH or RETURN. -/
def orderBy (e : Expr α) (desc : Bool := false) : QueryM Unit :=
  modify fun s => { s with pending.orderBy := s.pending.orderBy ++ [⟨e.raw, desc⟩] }

def orderByDesc (e : Expr α) : QueryM Unit := orderBy e true

def skip (n : Nat) : QueryM Unit :=
  modify fun s => { s with pending.skip := some (.value (.int64 (Int64.ofNat n))) }

def limit (n : Nat) : QueryM Unit :=
  modify fun s => { s with pending.limit := some (.value (.int64 (Int64.ofNat n))) }

/-- `UNWIND xs AS v`; returns the element variable. -/
def unwind (xs : Expr (Array τ)) : QueryM (Expr τ) := do
  let v ← QueryM.fresh "v"
  QueryM.emit (.unwind xs.raw v)
  return ⟨.var v⟩

private def propsOf (cols : Array Column) (v : Value) : List (String × Core.Expr) :=
  cols.toList.map fun c => (c.name, .value ((v.field? c.name).getD .null))

/-- `CREATE (n:Label {…})` from a Lean value; returns the new node's variable. -/
def create [NodeTable α] [ToValue α] [HasVar α V O] (x : α) : QueryM V := do
  let v ← QueryM.fresh "n"
  QueryM.emit (.create [⟨⟨v, some (NodeTable.label α), propsOf (NodeTable.columns α) (toValue x)⟩, []⟩])
  return HasVar.mkVar α v

/-- `CREATE (a)-[r:Label {…}]->(b)` between two bound nodes. -/
def createRel [RelTable ρ σ τ] [ToValue ρ] [HasVar ρ RV RO] [NodeVarOf S σ] [NodeVarOf T τ]
    (a : S) (r : ρ) (b : T) : QueryM RV := do
  let v ← QueryM.fresh "r"
  let rel : Core.RelPat := ⟨some v, RelTable.label ρ, .out, propsOf (RelTable.columns ρ) (toValue r)⟩
  QueryM.emit (.create [⟨⟨NodeVarOf.varName a, none, []⟩, [(rel, ⟨NodeVarOf.varName b, none, []⟩)]⟩])
  return HasVar.mkVar ρ v

/-- `MERGE (n:Label {key: …}) SET n.p = …` for every other property: creates the
node or overwrites the existing node with the same key. -/
def merge [NodeTable α] [ToValue α] [HasVar α V O] (x : α) : QueryM V := do
  let v ← QueryM.fresh "n"
  let value := toValue x
  let key := NodeTable.key α
  let keyVal := (value.field? key).getD .null
  QueryM.emit (.merge ⟨⟨v, some (NodeTable.label α), [(key, .value keyVal)]⟩, []⟩)
  let rest := (NodeTable.columns α).toList.filter (·.name != key)
  unless rest.isEmpty do
    QueryM.emit (.set (rest.map fun c => ⟨.prop (.var v) c.name, .value ((value.field? c.name).getD .null)⟩))
  return HasVar.mkVar α v

/-- `SET target = value`; `target` should be a property expression. -/
def set (target : Expr α) (value : Expr α) : QueryM Unit := QueryM.emit (.set [⟨target.raw, value.raw⟩])

def delete [IsVar V] (v : V) : QueryM Unit := QueryM.emit (.delete false [.var (IsVar.varName v)])
def detachDelete [IsVar V] (v : V) : QueryM Unit := QueryM.emit (.delete true [.var (IsVar.varName v)])

/-! ## Projections -/

/-- What WITH can carry forward: expressions get a fresh alias, variables keep their name. -/
class Projectable (P : Type) where
  project : P → QueryM (List Core.Item × P)

instance : Projectable (Expr α) where
  project e := do
    let v ← QueryM.fresh "v"
    return ([⟨e.raw, some v⟩], ⟨.var v⟩)

instance (priority := low) [IsVar V] : Projectable V where
  project x := return ([⟨.var (IsVar.varName x), none⟩], x)

instance [Projectable P] [Projectable Q] : Projectable (P × Q) where
  project | (p, q) => do
    let (a, p') ← Projectable.project p
    let (b, q') ← Projectable.project q
    return (a ++ b, (p', q'))

/-- `WITH items`: only what is returned stays in scope afterwards. -/
def with_ [Projectable P] (x : P) (distinct : Bool := false) : QueryM P := do
  let (items, x') ← Projectable.project x
  QueryM.emit (.with items distinct (← QueryM.takePending))
  return x'

/-- What RETURN can return, and the Lean type of each row. -/
class Returnable (P : Type) (α : outParam Type) where
  items : P → List Core.Expr

instance : Returnable (Expr α) α := ⟨fun e => [e.raw]⟩
instance (priority := low) [NodeVarOf V α] : Returnable V α := ⟨fun v => [.var (NodeVarOf.varName v)]⟩
instance (priority := low) [OptNodeVarOf V α] : Returnable V (Option α) := ⟨fun v => [.var (OptNodeVarOf.varName v)]⟩
instance (priority := low) [RelVarOf V ρ] : Returnable V ρ := ⟨fun v => [.var (RelVarOf.varName v)]⟩
instance (priority := low) [OptRelVarOf V ρ] : Returnable V (Option ρ) := ⟨fun v => [.var (OptRelVarOf.varName v)]⟩
instance [Returnable P α] [Returnable Q β] : Returnable (P × Q) (α × β) :=
  ⟨fun (p, q) => Returnable.items p ++ Returnable.items q⟩

/-- The end of a query that returns rows of `α`. -/
structure Ret (α : Type) where
  private mk ::

-- @tg: implements:: [[openspec:cypher-query#Result typing]]
def return_ [Returnable P α] (x : P) (distinct : Bool := false) : QueryM (Ret α) := do
  let items := (Returnable.items x).map (⟨·, none⟩)
  QueryM.emit (.return items distinct (← QueryM.takePending))
  return ⟨⟩

/-! ## Queries and statements -/

/-- A query returning rows of `α`. -/
structure Query (α : Type) where
  core : Core.Query
  decode : Row → Except Error α

/-- A query that returns nothing. -/
structure Statement where
  core : Core.Query
  deriving Inhabited

def query [FromRow α] (m : QueryM (Ret α)) : Query α :=
  let (_, s) := m.run {}
  ⟨⟨s.clauses⟩, FromRow.decode⟩

def stmt (m : QueryM Unit) : Statement :=
  let (_, s) := m.run {}
  ⟨⟨s.clauses⟩⟩

def Query.print (q : Query α) : String × Array (String × Value) := Cypher.print q.core
def Statement.print (s : Statement) : String × Array (String × Value) := Cypher.print s.core

/-- The Cypher text of a query, for tests and logs. -/
def Query.text (q : Query α) : String := q.print.1
def Statement.text (s : Statement) : String := s.print.1

end Ladybug
